# Copy to .env and fill in. The server reads this file at startup; .env is gitignored.
# These values are used by the Node server only — they are never bundled into the
# phone app, which reaches OpenAI through this server's /api/vision/identify.

# --- Photo recognition (optional) -------------------------------------------
# Without a key the app works exactly as before; the "Capture & identify"
# button then reports that recognition is not set up.
OPENAI_API_KEY=sk-...

# gpt-4o (default, more accurate) or gpt-4o-mini (cheaper). Each device can
# override this in Setup → Data → AI photo recognition.
OPENAI_MODEL=gpt-4o

# Point at a proxy or a compatible gateway if you do not call OpenAI directly.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Give a slow link room to answer; the phone shows a timeout message after this.
# OPENAI_TIMEOUT_MS=45000

# --- Database (Vercel deployment only) ---------------------------------------
# The serverless functions in api/ need Postgres; the on-site Node server uses
# SQLite and ignores this. Vercel Postgres sets POSTGRES_URL for you when you
# attach a database; for Neon or Supabase, paste their connection string here.
#
# Use the POOLED string. Every serverless invocation opens its own socket, so
# direct connections run the database out of slots: Neon's "-pooler" host, or
# Supabase's port 6543 endpoint.
# POSTGRES_URL=postgres://user:pass@host-pooler.region.aws.neon.tech/db?sslmode=require

# --- Server ------------------------------------------------------------------
# PORT=4000
# DATA_DIR=server/data
# UPLOAD_DIR=server/uploads

# Seeded server admin. Change the password before any real exercise.
# ADMIN_EMAIL=admin@sufa.ac.tz
# ADMIN_PASSWORD=verify123
